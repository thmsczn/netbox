{#-
  Export template NetBox — Adresses IP (IPAM > IP Addresses)
  Colonnes : IP;VRF;Status;Tenant;DNS;Tags;Subnet;Subnet Tenant;Subnet Role;Subnet Site;Subnet Tags;VLAN ID;VLAN
  Le subnet est le préfixe le plus spécifique contenant l'IP dans la même VRF,
  le VLAN est celui associé à ce préfixe.
  Site du subnet : déduit du scope (Site, ou site de la Location) ; vide si le
  scope est une Region / un Site Group. Compatible avec l'ancien champ "site".
-#}
IP;VRF;Status;Tenant;DNS;Tags;Subnet;Subnet Tenant;Subnet Role;Subnet Site;Subnet Tags;VLAN ID;VLAN
{% for ip in queryset -%}
{%- set prefix = ipam.Prefix.objects.filter(vrf=ip.vrf, prefix__net_contains_or_equals=ip.address.ip|string).order_by('-prefix').first() -%}
{%- set vlan = prefix.vlan if prefix else None -%}
{%- set ns = namespace(site=None) -%}
{%- if prefix -%}
  {%- if prefix.site is defined -%}
    {%- set ns.site = prefix.site -%}
  {%- elif prefix.scope_type and prefix.scope -%}
    {%- if prefix.scope_type.model == 'site' -%}
      {%- set ns.site = prefix.scope -%}
    {%- elif prefix.scope_type.model == 'location' -%}
      {%- set ns.site = prefix.scope.site -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
{{ ip.address }};
{{- ip.vrf.name if ip.vrf else 'Global' }};
{{- ip.get_status_display() }};
{{- ip.tenant.name if ip.tenant else '' }};
{{- ip.dns_name or '' }};
{{- ip.tags.all()|join(',', attribute='name') }};
{{- prefix.prefix if prefix else '' }};
{{- prefix.tenant.name if prefix and prefix.tenant else '' }};
{{- prefix.role.name if prefix and prefix.role else '' }};
{{- ns.site.name if ns.site else '' }};
{{- prefix.tags.all()|join(',', attribute='name') if prefix else '' }};
{{- vlan.vid if vlan else '' }};
{{- vlan.name if vlan else '' }}
{% endfor -%}
