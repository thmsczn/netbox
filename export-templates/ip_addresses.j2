{#-
  NetBox export template — IP addresses (IPAM > IP Addresses)
  Columns: IP;VRF;Status;Tenant;DNS;Tags;Subnet;Subnet Tenant;Subnet Role;Subnet Scope;Subnet Tags;VLAN ID;VLAN
  The subnet is the most specific prefix containing the IP in the same VRF;
  the VLAN is the one assigned to that prefix.
  Subnet scope: name of the prefix scope (Region, Site Group, Site or Location).
-#}
IP;VRF;Status;Tenant;DNS;Tags;Subnet;Subnet Tenant;Subnet Role;Subnet Scope;Subnet Tags;VLAN ID;VLAN
{% for ip in queryset -%}
{%- set prefix = ipam.Prefix.objects.filter(vrf=ip.vrf, prefix__net_contains_or_equals=ip.address.ip|string).order_by('-prefix').first() -%}
{%- set vlan = prefix.vlan if prefix else None -%}
{%- set scope = prefix.scope if prefix else None -%}
{{ ip.address }};
{{- ip.vrf.name if ip.vrf else 'Global' }};
{{- ip.get_status_display() }};
{{- ip.tenant.name if ip.tenant else '' }};
{{- ip.dns_name or '' }};
{{- ip.tags.all()|join(',', attribute='name') }};
{{- prefix.prefix if prefix else '' }};
{{- prefix.tenant.name if prefix and prefix.tenant else '' }};
{{- prefix.role.name if prefix and prefix.role else '' }};
{{- scope.name if scope else '' }};
{{- prefix.tags.all()|join(',', attribute='name') if prefix else '' }};
{{- vlan.vid if vlan else '' }};
{{- vlan.name if vlan else '' }}
{% endfor -%}
